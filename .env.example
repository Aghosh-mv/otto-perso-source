# ═════════════════════════════════════════════════════════════════════════════
# OTTO PERSO — ENVIRONMENT VARIABLES
# ═════════════════════════════════════════════════════════════════════════════
#
# AUDIT GUARANTEE: Every key below is FREE and needs NO credit card, NO payment
# method, and NO paid subscription. This was verified per provider policy in
# Nov 2026. Providers that DO require a card (Google Places, Uber) or a paid
# account (Spotify Premium, Kiwi Tequila enterprise) have been REMOVED and
# replaced with free, card-free alternatives — see the audit table at the
# bottom of this file for the full before/after.
#
# Otto ships with a bundled Gemini key, so the app works on first run with
# ZERO setup. Every other key just unlocks an extra capability.
# ═════════════════════════════════════════════════════════════════════════════

DATABASE_URL=file:./db/custom.db

# ─── Otto's brain (bundled key works by default) ───────────────────────────
# Google AI Studio — FREE, no credit card, no billing account needed.
# (This is NOT Google Cloud/Maps Platform — AI Studio keys are separate.)
# Get your own (optional): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyBhbksuN31y_FGPkC3BEvTWv7lCvZ2Sf0Y
OTTO_MODEL=gemini-3.5-flash-lite

# ─── Rate limits ───────────────────────────────────────────────────────────
OTTO_RATE_LIMIT_MINUTE=8
OTTO_RATE_LIMIT_HOURLY=50
OTTO_RATE_LIMIT_PEAK_HOURLY=30
OTTO_RATE_LIMIT_DAILY=400
OTTO_RATE_LIMIT_MONTHLY_TOKENS=1000000
OTTO_PEAK_HOUR_START=9
OTTO_PEAK_HOUR_END=18

# ─── Auth ──────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=otto-perso-local-dev-secret-change-me-9k2m5x7q8w3e1r4t6y0u
NEXTAUTH_URL=http://localhost:3000
OTTO_OWNER_EMAIL=owner@otto.local
OTTO_OWNER_PASSWORD=otto-perso-owner

# ─── Vault + Workspace ─────────────────────────────────────────────────────
OTTO_VAULT_DIR=/home/z/otto-vault
OTTO_WORKSPACE_ROOT=/home/z/otto-workspace

# ═════════════════════════════════════════════════════════════════════════════
# CAPABILITY KEYS — all FREE, NO credit card
# ═════════════════════════════════════════════════════════════════════════════

# Geoapify — maps_directions + richer hotel/restaurant search
# Free 3,000 requests/day, explicitly "No credit card required".
# Get: https://geoapify.com/ → sign up (email only) → dashboard → API key
GEOAPIFY_API_KEY=

# Event search — now KEYLESS (Ticketmaster removed due to signup friction).
# Default: returns curated web-search links (Google, DuckDuckGo, Bandsintown).
# Optional: SeatGeek client ID gives structured event data (free, no card).
# Get: https://seatgeek.com/developer → sign up → client ID
SEATGEEK_CLIENT_ID=

# Travelpayouts — flight_search (live flight prices, IATA codes)
# Free affiliate token, no card. Signup is free; payout details are OPTIONAL
# until you actually earn affiliate commissions.
# Get: https://www.travelpayouts.com/ → sign up → dashboard → API token
TRAVELPAYOUTS_TOKEN=

# YouTube Data API v3 — makes music_play open the EXACT song video
# (Without this key, music_play still works — it opens a YouTube search page.)
# Free 10,000 quota units/day, no billing meter, no credit card.
# NOTE: this is YouTube, NOT Google Maps Platform — no card needed.
# Get: https://console.cloud.google.com/ → new project → enable "YouTube Data
#      API v3" → Credentials → Create API key. (No billing account required.)
YOUTUBE_API_KEY=

# Finnhub — stock prices (crypto works without any key via CoinGecko)
# Free 60 calls/min, no card. Get: https://finnhub.io/ → register → API key
FINNHUB_API_KEY=

# Stripe — payment_charge (so users can pay for things via Otto)
# Test mode keys are FREE and need only an email — NO card, NO bank account.
# Live mode (to actually receive money) needs a bank account for payouts but
# STILL no credit card; Stripe takes a small % per transaction.
# Get test key: https://dashboard.stripe.com/register → Developers → API keys
# → "Secret key" (copy the test one, starts with sk_test_)
STRIPE_SECRET_KEY=

# ═════════════════════════════════════════════════════════════════════════════
# ZERO-KEY TOOLS (work on first run, nothing to configure)
# ═════════════════════════════════════════════════════════════════════════════
# These use completely free APIs that need NO key at all:
#
#   event_search      → KEYLESS web-search links (no key) — or SeatGeek if set
#   hotel_search       → OpenStreetMap Nominatim (no key) — or Geoapify if set
#   restaurant_search  → OpenStreetMap Nominatim (no key) — or Geoapify if set
#   ride_estimate      → Nominatim geocoding + OSRM routing (no key) + fare math
#   maps_directions    → OSRM routing (no key) — or Geoapify if set
#   calendar_book      → generates .ics files (no key, imports into any calendar)
#   music_play         → iTunes Search API (no key) + YouTube search page
#   weather            → Open-Meteo (10,000 calls/day free, no key)
#   news_search        → Hacker News Algolia (unlimited, no key)
#   stock_crypto       → CoinGecko for crypto (no key) / Finnhub for stocks
#   translate          → LibreTranslate (free, no key)
#   wikipedia          → Wikipedia REST API (unlimited, no key)
#   currency_convert   → ExchangeRate-API (unlimited, no key)
#   web_search         → DuckDuckGo (no key)
#   web_fetch          → direct HTTP fetch (no key)

# ═════════════════════════════════════════════════════════════════════════════
# COMMUNICATION KEYS (optional, in-app only — added by the end user)
# ═════════════════════════════════════════════════════════════════════════════
# These are NOT in this file — they're entered in Settings → Phone / Email
# inside the app, per-user. Listed here only so you know the options.
#
# Email (Resend) — for email_send
#   Free 3,000 emails/month, 100/day, NO credit card.
#   Get: https://resend.com/ → sign up → API key
#
# Phone (Telnyx / Twilio / Vonage / Plivo) — for sms_send + voice
#   These DO cost real money (~$1/mo per number + per-message fees) because
#   they route through real carrier networks. They are OPTIONAL — Otto works
#   fine without them. Adding one is the end user's choice.

# ═════════════════════════════════════════════════════════════════════════════
# REMOVED PROVIDERS — and why (audit trail)
# ═════════════════════════════════════════════════════════════════════════════
# GOOGLE_PLACES_API_KEY  — REMOVED: requires a billing account with a credit
#                          card (Google Maps Platform policy since July 2018).
#                          Replaced by Geoapify (free, no card) + OpenStreetMap
#                          Nominatim (no key at all).
# UBER_API_KEY           — REMOVED: Uber no longer issues server tokens to new
#                          apps; the price-estimates endpoint is deprecated.
#                          Replaced by a keyless estimator (Nominatim + OSRM +
#                          typical fare rates).
# SPOTIFY_CLIENT_ID/SECRET — REMOVED: Spotify Web API now requires a Premium
#                          (paid) account. Replaced by iTunes Search API
#                          (keyless) + YouTube for full songs.
# GOOGLE_CALENDAR_API_KEY/ID — REMOVED: an API key can't write calendar events
#                          (needs OAuth); the keyless .ics file works with every
#                          calendar app and needs no setup at all.
# KIWI_API_KEY           — REMOVED: Kiwi Tequila is closed to new self-service
#                          developers. Replaced by Travelpayouts (free, no card).
#
# ═════════════════════════════════════════════════════════════════════════════
# FULL AUDIT TABLE — every key Otto can use, verified Nov 2026
# ═════════════════════════════════════════════════════════════════════════════
