{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Otto Perso",
  "version": "1.0.0",
  "identifier": "com.ottoperso.app",
  "build": {
    "beforeBuildCommand": "node scripts/build-standalone.js",
    "beforeDevCommand": "npm run dev:next",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Otto Perso",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 Otto Perso",
    "category": "Productivity",
    "shortDescription": "Your digital employee. Lives on your computer.",
    "longDescription": "Otto Perso is an autonomous agent that lives on your computer."
  }
}
